# Local editor settings
/.vscode/

# Sibling git worktrees attached to this repo: the grove-meta worktree
# (cross-grove inbox state) and active grove worktrees. Each lives on
# its own branch and must not appear as untracked in main's tree.
/.grove-meta
/.grove-worktrees

# superpowers brainstorming visual companion (local-only)
.superpowers/
# Apalache's per-run scratch directory, written into the working tree by
# `quint verify`. The runner that set `QUINT_VERIFY=1` (`models/run.sh`) went
# with the formal-methods apparatus, and the surviving
# `docs/ordinal-fs-tree/models/run-quint.sh` never invoked Apalache — so nothing
# in the repo writes this now. Kept because the directory is scratch either way,
# and anyone re-running Quint by hand against those models would recreate it.
/_apalache-out

.grove.kdl
