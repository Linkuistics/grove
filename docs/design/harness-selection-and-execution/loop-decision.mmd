flowchart TB
  Start["Start here: the shared job function returned"]:::start
  Restore["Restore/reset terminal;
release session witness"]
  Epoch{"Epoch invalidated?"}
  Failed{"Spawn or wait failed?"}
  Fatal["Error: read no disposition,
launch no next session;
after the report, die of a caught signal"]
  Interrupt{"Driver interrupted?"}
  Interrupted["Interrupted with signal"]
  ForceStop{"Successful Ravel status and
exactly grove-force-stop?"}
  ForceStopped["Force-stopped: exit 1, no completion;
remaining live work resumable"]
  Teardown{"This launch's teardown record?"}
  Finished["Finished regardless of
result or status"]
  Status{"Successful Ravel status?"}
  Result{"Exactly grove-continue?"}
  Continue["Continue to next pick"]
  Stop["Stop; rerun to resume
remaining tree"]
  Start -->|"1"| Restore
  Restore -->|"2"| Epoch
  Epoch -->|"No"| Fatal
  Epoch -->|"3. Yes"| Failed
  Failed -->|"Yes"| Fatal
  Failed -->|"4. No"| Interrupt
  Interrupt -->|"Yes"| Interrupted
  Interrupt -->|"5. No"| ForceStop
  ForceStop -->|"Yes"| ForceStopped
  ForceStop -->|"6. No"| Teardown
  Teardown -->|"Yes"| Finished
  Teardown -->|"7. No"| Status
  Status -->|"No"| Stop
  Status -->|"8. Yes"| Result
  Result -->|"Yes"| Continue
  Result -->|"No"| Stop
