flowchart LR
    subgraph prep["Ordinary leaves"]
        direction TB
        A["Start here · Baseline and design"]
        B["Pack moves keep every entry<br/>Two skill-free plugins added<br/>Packs published"]
        C["Re-inventory per entry"]
        D["Draft config.rhai, skill settings<br/>and checkout entries"]
        E["Credential control, staging clones<br/>then staging-HOME trials<br/>on both harnesses"]
        F["Prepare real HOME, clone checkouts<br/>Rehearse the program on the plan<br/>with every control"]
        A -->|1| B
        B -->|2| C
        C -->|3| D
        D -->|4| E
        E -->|5| F
    end
    subgraph fin["Finish"]
        direction TB
        G["Release Grove<br/>Promote Ravel"]
        H{"No other session, driver,<br/>writer or job outside<br/>the run's own tree?"}
        I["Ask the owner<br/>Signal nobody"]
        S{"State from the layout,<br/>the run record of the<br/>latest backup and the plan"}
        R["Resume the inverse<br/>of the open run"]
        D["Drifted: change nothing<br/>Report each cell"]
        C["Changed: stop for<br/>classification and a<br/>new rehearsed plan"]
        P["Compare core tree ID<br/>Advance grove-core pin<br/>Clean status, accepted digests<br/>Rehearsal names plan and program<br/>No flagged kept copy"]
        Q["Pending-activation record<br/>No success signal<br/>Switch runs again"]
        J["One program, parts in order:<br/>read, stage, exchange or<br/>exclusive rename, compare"]
        K{"Both probes pass and<br/>each cell still as probed?"}
        L["Inverse of the run's parts<br/>then native probe"]
        M["Receipt records the probed cells<br/>Manual entry valid while<br/>mac-check reports complete"]
        G -->|7| H
        H -->|"8 no"| I
        H -->|"8 yes"| S
        S -->|"8a native, probe passes"| P
        S -.->|"8a interrupted"| R
        S -->|"8a active: step 6, then probes"| K
        S -.->|"8a drifted"| D
        S -.->|"8a changed"| C
        S -->|"8a complete"| M
        R -.->|"state again"| S
        P -->|"8b"| J
        P -.->|"8b stops"| Q
        J -->|9| K
        J -.->|"9 conflict"| L
        K -->|"10 no"| L
        L -.->|"pending record"| Q
        K -->|"10 yes"| M
        D -.->|"pending record"| Q
        C -.->|"pending record"| Q
        M -.->|"receipt not written"| Q
        Q -.->|"run again from step 1"| H
    end
    prep -->|"6 after acceptance"| fin
    classDef start fill:#16354a,color:#fff,stroke:#16354a,font-weight:bold
    class A start
