flowchart TB
    A["Start here · Prepare accepted sources<br/>and isolated staging evidence"]
    B["Prepare serial program and real plan<br/>Dry-run switch and full restore<br/>Identify command inputs by content"]
    C["Finish releases Grove<br/>and promotes Ravel"]
    D{"Owner checklist complete?<br/>No other harness or driver?"}
    E["Verify sources, layout<br/>and finish's reader paths"]
    F["One complete backup<br/>before every switch write"]
    G["Write Ravel off value<br/>Install disabled writing hooks"]
    H["Deactivate native copies<br/>Enable native capabilities<br/>Write switched Ravel settings last"]
    I{"Both real-HOME probes pass?<br/>Final layout and readers agree?"}
    J["Receipt and manual verified<br/>Original finish ending"]
    R["Full restore from the backup<br/>Ravel sources explicitly off<br/>Verify native delivery, then stop"]
    S["Stop before mutation<br/>Resolve checklist or preparation"]
    A -->|"1"| B
    B -->|"2"| C
    C -->|"3"| D
    D -->|"4 yes"| E
    D -->|"4 no"| S
    E -->|"5 verified"| F
    E -->|"5 failed"| S
    F -->|"6 complete"| G
    F -->|"6 incomplete: no write"| S
    G -->|"7"| H
    H -->|"8"| I
    I -->|"9 yes"| J
    G -.->|"failure"| R
    H -.->|"failure"| R
    I -->|"9 no"| R
    J -.->|"receipt or final comparison fails"| R
    classDef start fill:#16354a,color:#fff,stroke:#16354a,font-weight:bold
    class A start
