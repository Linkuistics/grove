flowchart TB
    subgraph mise["The owner's tool: mise bootstrap (other users choose their own)"]
        direction TB
        A["Start here · Pack commit<br/>published on its remote"]
        B["Owner edits the ref<br/>in [bootstrap.repos]"]
        C["mise -C HOME bootstrap repos apply<br/>only while nothing captures it<br/>fetches, then checks out the ref"]
        E{"Fetch succeeds?"}
        D[("Pack checkout<br/>~/.local/share/skill-packs/ID")]
        F["Checkout unchanged<br/>status reports differs"]
        K["mac-check runs<br/>repos status --missing"]
        A -->|1| B
        B -->|2| C
        C -->|3| E
        E -->|"4 yes"| D
        E -->|"4 no, offline advance"| F
        K -.->|"reports missing, differs,<br/>dirty or conflict"| D
    end
    subgraph ravel["Ravel reads local directories only"]
        direction TB
        G{"Source directory<br/>and roots exist?"}
        H["Capture current files<br/>Reuse snapshot by digest"]
        I["skill_source_missing<br/>exit 3, no worker"]
        J["Session reads<br/>the retained snapshot"]
        G -->|"6 yes"| H
        G -->|"6 no"| I
        H -->|7| J
    end
    D -->|"5 at each launch"| G
    F -.->|"previous revision<br/>keeps launching"| G
    I -.->|"owner runs apply,<br/>then reruns Grove"| C
    classDef start fill:#16354a,color:#fff,stroke:#16354a,font-weight:bold
    class A start
