flowchart TB
  Start["Start here: the PATH of this<br/>Grove invocation selects one ravel"]:::start
  Probe{"Grove probes<br/>ravel --version"}
  Refuse["Grove refuses: 1.0, prerelease,<br/>unknown major such as 3.x,<br/>malformed or failed probe<br/>No other PATH entry is tried"]
  V1["Ravel 1.x from 1.1.0<br/>policy.ts, schemaVersion 2<br/>Grove's TypeScript assets"]
  V2["Ravel 2.x from 2.0.0<br/>config.rhai, SCHEMA_VERSION 4<br/>Grove's Rhai assets"]
  Skills{"Ravel reads settings:<br/>skills with<br/>configured sources?"}
  N1["Native route on 1.1<br/>Native skills in each harness"]
  N2["Native route on 2.0<br/>Delivery disabled<br/>prompt equals originalPrompt"]
  D2["Directory route on 2.0<br/>Prepared prompt and snapshot reads<br/>Native copies unnecessary"]
  M1["Ravel 1.1 refuses a 2.0 settings key<br/>before launch. Leaf stays live"]
  M2["Ravel 2.0 refuses a lone policy.ts,<br/>schema 3 or policyEnv before launch<br/>Leaf stays live"]
  Start -->|"1. First absolute PATH entry"| Probe
  Probe -->|"2. Admitted 1.x"| V1
  Probe -->|"2. Admitted 2.x"| V2
  Probe -->|"2. Otherwise"| Refuse
  V1 -->|"3. Settings without 2.0 keys"| N1
  V2 -->|"3. Configuration found"| Skills
  Skills -->|"4. No"| N2
  Skills -->|"4. Yes"| D2
  V1 -.->|"Mismatched settings"| M1
  V2 -.->|"Mismatched configuration"| M2
  classDef start fill:#163a57,color:#fff,stroke:#163a57,font-weight:bold
