#!/usr/bin/env bash
# grove-start — create a worktree for a new grove and launch a bootstrap session.
#
#   grove-start <grove-name> [<start-point>]
#
#   <grove-name>   the grove's slug; used for the worktree dir
#                  (worktrees/<grove-name>-grove/), the branch
#                  (<grove-name>-grove), and the session name.
#   <start-point>  commit/branch the new worktree branches off
#                  (default: origin's HEAD branch, else `main`).
#
# Run from anywhere inside the repo (main checkout or another worktree).
# The script finds the main checkout via `git rev-parse --git-common-dir`.
set -euo pipefail

die() { echo "grove-start: $*" >&2; exit 1; }

grove="${1:-}"
start="${2:-}"
[[ -n "$grove" ]] || die "usage: grove-start <grove-name> [<start-point>]"
[[ "$grove" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
  || die "grove name must be kebab-case (lowercase, digits, hyphens): $grove"

git rev-parse --git-common-dir >/dev/null 2>&1 || die "not in a git repo"
main_repo="$(cd "$(dirname "$(git rev-parse --git-common-dir)")" && pwd)"
repo_name="$(basename "$main_repo")"
worktree="$main_repo/worktrees/${grove}-grove"
branch="${grove}-grove"

[[ -e "$worktree" ]] && die "worktree already exists: $worktree (use grove-next $grove)"
git -C "$main_repo" show-ref --verify --quiet "refs/heads/$branch" \
  && die "branch already exists: $branch"

if [[ -z "$start" ]]; then
  start="$(git -C "$main_repo" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null \
           | sed 's|^origin/||')"
  start="${start:-main}"
fi
git -C "$main_repo" rev-parse -q --verify "${start}^{commit}" >/dev/null \
  || die "start point not found: $start"

git -C "$main_repo" worktree add "$worktree" -b "$branch" "$start"

cd "$worktree"
exec claude -n "${repo_name}: ${grove} grove" \
  "Start a new grove called ${grove} in this worktree. Use grove's start-a-new-grove flow: grill me on the goal first (use the bundled grilling procedure), sharpening new terminology into CONTEXT.md inline. Then propose the root groves/${grove}/BRIEF.md (per BRIEF-FORMAT.md) and a small initial decomposition — first one or two leaves only. Don't over-plan."
