{
  "description": "technical-communication always-on layers (they fail open and quietly; the off file turns them off)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/technical-communication/scripts/tc-hook",
              "claude-code",
              "session-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/technical-communication/scripts/tc-hook",
              "claude-code",
              "subagent-start"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/technical-communication/scripts/tc-hook",
              "claude-code",
              "prompt"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/technical-communication/scripts/tc-hook",
              "claude-code",
              "write"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/technical-communication/scripts/tc-hook",
              "claude-code",
              "reply"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/technical-communication/scripts/tc-hook",
              "claude-code",
              "reply"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
